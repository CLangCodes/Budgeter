    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
</Project>