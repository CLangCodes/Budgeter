    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: BudgetBuddy Debug",
            "type": "dotnet",
            "request": "launch",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar"
            },
            "launchConfigurationId": "TargetFramework=;https",
            "projectPath": "${workspaceFolder}/src/BudgetBuddy/BudgetBuddy.csproj"
        }
    ]
}